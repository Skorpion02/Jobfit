# Variables OPCIONALES para sobreescribir la config de los contenedores (GPU o CPU).
# Son variables de INTERPOLACION de Docker Compose (prefijo JOBFIT_), no se inyectan
# directamente: el compose las usa para construir LMSTUDIO_BASE_URL/MODEL dentro del
# contenedor. Se llaman JOBFIT_* a proposito para NO colisionar con el .env del proyecto
# (uso nativo en Windows), que define LMSTUDIO_BASE_URL=http://localhost:1234/v1.
#
# Por defecto (sin definir nada) el contenedor ya usa host.docker.internal:1234, correcto
# para LM Studio corriendo en el mismo PC con Docker Desktop. Solo necesitas estas variables
# si el LLM esta en OTRO servidor.
#
# Como aplicarlas (elige una):
#   A) Exportar en la shell antes de levantar (PowerShell):
#        $env:JOBFIT_LMSTUDIO_URL="http://192.168.1.50:1234/v1"; docker compose up -d
#   B) Anadirlas al .env del proyecto (no colisionan, llevan prefijo JOBFIT_).
#   C) Usar este archivo como env-file de interpolacion:
#        docker compose --env-file .env.docker.example up -d

# URL del servidor LLM externo (OpenAI-compatible). IMPORTANTE: dentro del contenedor NO
# uses 'localhost'. Usa host.docker.internal (mismo PC) o la IP del servidor.
JOBFIT_LMSTUDIO_URL=http://host.docker.internal:1234/v1

# Modelo cargado en el servidor LLM
JOBFIT_LMSTUDIO_MODEL=qwen/qwen2.5-14b-instruct

# Activar el uso del LLM (false -> modo reglas, sin LLM)
JOBFIT_USE_LMSTUDIO=true
